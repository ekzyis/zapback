package pages

import (
    "github.com/ekzyis/zapback/pages/components"
    "github.com/ekzyis/zapback/pages/types"
)

templ NewGame(err types.FormError) {
    <html>
        @components.Head()
        @components.Body() {
			@components.Content() {
                <div id="banner-new">
                    @components.Figlet("slant", "new game")
                </div>
                <div class="mb-3">
                    To start a new game, you must fund the pool with your first zap.
                    The size of your first zap determines the size of each zap in the game.
                    Last zapper within 24 hours wins!
                </div>
                <form
                    hx-post="/new"
                    hx-target="#modal"
                    hx-select="#modal"
                    hx-push-url="false">
                    <div class="grid grid-cols-[auto_auto] gap-x-4 items-center my-3">
                        <label for="zap_amount">zap amount</label>
                        <div class="relative">
                            <input
                                id="zap_amount"
                                name="zap_amount"
                                type="number"
                                class="my-1 p-2 pr-12 border rounded"
                                hx-preserve />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-muted">sats</span>
                        </div>
                        if hasError(err, "zap_amount") {
                            <div class="error col-start-2">{ err["zap_amount"] }</div>
                        }
                        <label for="lnaddr">lightning address</label>
                        <!-- TODO: outline input on error while preserving value -->
                        <input
                            id="lnaddr"
                            name="lnaddr"
                            type="text"
                            class="my-1 p-2 border rounded w-full"
                            placeholder="how you get paid if you win"
                            hx-preserve />
                        if hasError(err, "lnaddr") {
                            <div class="error col-start-2">{ err["lnaddr"] }</div>
                        }
                    </div>
                    <div class="flex justify-end">
                        <a
                            id="cancel"
                            class="mx-3"
                            hx-get="/"
                            hx-target="#content"
                            hx-select="#content"
                        >cancel</a>
                        <button type="submit">submit</button>
                    </div>
                </form>
            }
        }
    </html>
}

func hasError(err types.FormError, field string) bool {
    return err != nil && err[field] != ""
}
