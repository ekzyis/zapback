package pages

import "github.com/ekzyis/zapback/pages/components"

templ NewGame() {
    <html>
        @components.Head()
        @components.Body() {
			@components.Content() {
                <div id="banner-new">
                    @components.Figlet("slant", "new game")
                </div>
                <form hx-post="/new">
                    <div class="grid grid-cols-[auto_auto] gap-4 items-center">
                        <label for="pool_amount">pool amount</label>
                        <input
                            id="pool_amount"
                            name="pool_amount"
                            type="number"
                            class="my-3 p-2 border rounded" />
                    </div>
                    <div class="flex justify-end">
                        <a
                            id="cancel"
                            class="mx-3"
                            hx-get="/"
                        >cancel</a>
                        <button type="submit">submit</button>
                    </div>
                </form>
            }
        }
    </html>
}