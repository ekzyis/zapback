package components

import (
	"fmt"
	"math"
	"time"

	"github.com/ekzyis/zapback/db"
	"net/url"
)

templ Invoice(invoice *db.Invoice) {
	<div class="p-5 bg-background text-center font-mono">
		<div class="mb-3 font-bold">Payment Required</div>
		@InvoiceDescription(invoice)
		@InvoiceQr(invoice)
	</div>
}

templ GameInvoice(invoice *db.Invoice) {
	<div class="text-center font-mono">
		@InvoiceQr(invoice)
	</div>
}

templ InvoiceDescription(invoice *db.Invoice) {
	<div>{ invoice.Description.String }</div>
}

templ InvoiceQr(invoice *db.Invoice) {
	<div class="my-1">
		@Qr(invoice.PaymentRequest, "lightning:"+invoice.PaymentRequest)
	</div>
	<div class="my-1">{ format(invoice.MsatsRequested) }</div>
	@InvoiceStatus(invoice, nil)
	<div class="hidden" id="bolt11-data" bolt11-data={ templ.JSONString(invoice.PaymentRequest) }></div>
}

templ InvoiceStatus(invoice *db.Invoice, redirectUrl *url.URL) {
	<div id="status">
		if invoice.ConfirmedAt.Valid {
			<div class="font-mono neon success my-1">PAID</div>
			<!-- TODO: show timer for redirect -->
			if redirectUrl != nil {
				<div
					id="poll"
					hx-get={ string(templ.SafeURL(redirectUrl.String())) }
					hx-trigger="load delay:3s"
					hx-target="#content"
					hx-swap="outerHTML"
					hx-select="#content"
					hx-push-url="true"
					hx-select-oob="#modal" />
			}
		} else if invoice.ExpiresAt.Before(time.Now()) {
			<div class="font-mono neon error my-1">EXPIRED</div>
		} else {
            <!-- TODO: add PENDING -->
			<div class="font-mono my-1" id="countdown" countdown-data={ templ.JSONString(math.Floor(invoice.ExpiresAt.Sub(time.Now()).Seconds())) } hx-preserve></div>
			<script type="text/javascript" id="countdown-js" hx-preserve>
                var expiresIn = JSON.parse($("#countdown").getAttribute("countdown-data"))

                function pad(num, places) {
                    return String(num).padStart(places, "0")
                }

                function _countdown() {
                    var hours = Math.floor(expiresIn / 3600)
                    var minutes = Math.floor((expiresIn % 3600) / 60)
                    var seconds = expiresIn % 60
                    var text = `${pad(hours, 2)}:${pad(minutes, 2)}:${pad(seconds, 2)}`
                    try {
                        $("#countdown").innerText = text
                        expiresIn--
                    } catch {
                        // countdown element disappeared
                        clearInterval(interval)
                    }
                }

                _countdown()
                var interval = setInterval(_countdown, 1000)
            </script>
            <div
                id="poll"
                hx-get={ string(templ.SafeURL("/invoice/" + invoice.PaymentHash)) }
                hx-trigger="load delay:1s"
                hx-target="#status"
                hx-swap="outerHTML"
                hx-select="#status"
                hx-push-url="false"
                hx-indicator="#hide-indicator"
            ></div>
            <div class="hidden" id="hide-indicator"></div>
		}
	</div>
}

func format(msats int64) string {
	sats := msats / 1000
	if sats == 1 {
		return fmt.Sprintf("%d sat", sats)
	}
	return fmt.Sprintf("%d sats", sats)
}
