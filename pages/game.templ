package pages

import (
	"github.com/ekzyis/zapback/db"
	"github.com/ekzyis/zapback/pages/components"
	"fmt"
	"github.com/ekzyis/zapback/pages/types"
)

templ Game(g *db.Game, err types.FormError) {
    <html>
        @components.Head()
        @components.Body() {
			@components.Content() {
                <div id="banner">
                    @components.Figlet("slant", "zapback")
                </div>
                <div class="mb-4">
                    <p class="text-center font-bold mb-3">
                        You have been invited to join a zapback game!
                    </p>
                    <p class="mb-3">
                        Here's how it works:
                    </p>
                    <ol class="list-disc list-inside">
                        <li>Zap the pool to start the game</li>
                        <li>Your friend has 24 hours to take their turn by zapping the pool</li>
                        <li>If they don't zap in time, you win the entire pool!</li>
                        <li>If they do zap, it becomes your turn again</li>
                        <li>The last person to zap within the 24 hour window wins!</li>
                    </ol>
                </div>
                <form
                    hx-post={ fmt.Sprintf("/game/%s/start", g.Code) }
                    hx-target="#modal"
                    hx-select="#modal"
                    hx-push-url="false"
                    hx-disabled-elt="button[type='submit']"
                    hx-on::before-request="document.querySelectorAll('.text-error').forEach(el => el.remove())">
                    <div class="grid grid-cols-[auto_auto] gap-x-4 items-center my-3">
                        <label for="lnaddr">lightning address</label>
                        <input
                            id="lnaddr"
                            name="lnaddr"
                            type="text"
                            class="my-1 p-2 rounded w-full"
                            placeholder="how you get paid if you win"
                            autocomplete="off"
                            hx-preserve />
                        if err.HasError("lnaddr") {
                            <div class="text-error text-sm text-end col-start-2">{ err["lnaddr"] }</div>
                        }
                    </div>
                    <div class="flex justify-center">
                        <button type="submit" class="neon success !p-3">START GAME</button>
                    </div>
                </form>
            }
        }
    </html>
}