package pages

import (
	"github.com/ekzyis/zapback/db"
	"github.com/ekzyis/zapback/pages/components"
	"fmt"
	"github.com/ekzyis/zapback/pages/types"
	_context "github.com/ekzyis/zapback/pages/context"
)

templ GameForm(err types.FormError) {
    <html>
        @components.Head()
        @components.Body() {
			@components.Content() {
                <div id="banner-new">
                    @components.Figlet("slant", "new game")
                </div>
                <div class="mb-3">
                    To start a new game, you must fund the pool with your first zap.
                    The size of your first zap determines the size of each zap in the game.
                    Last zapper within 24 hours wins!
                </div>
                <form
                    hx-post="/game"
                    hx-target="#modal"
                    hx-select="#modal"
                    hx-push-url="false"
                    hx-disabled-elt="button[type='submit']"
                    hx-on::before-request="document.querySelectorAll('.text-error').forEach(el => el.remove())">
                    <div class="grid grid-cols-[auto_auto] gap-x-4 items-center my-3">
                        <label for="zap_amount">zap amount</label>
                        <div class="relative">
                            <input
                                id="zap_amount"
                                name="zap_amount"
                                value="100"
                                type="number"
                                class="my-1 p-2 pr-12 rounded"
                                hx-preserve />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-muted">sats</span>
                        </div>
                        if err.HasError("zap_amount") {
                            <div class="text-error text-sm text-end col-start-2">{ err["zap_amount"] }</div>
                        }
                        <label for="lnaddr">lightning address</label>
                        <!-- TODO: outline input on error while preserving value -->
                        <input
                            id="lnaddr"
                            name="lnaddr"
                            type="text"
                            class="my-1 p-2 rounded w-full"
                            placeholder="how you get paid if you win"
                            autocomplete="off"
                            hx-preserve />
                        if err.HasError("lnaddr") {
                            <div class="text-error text-sm text-end col-start-2">{ err["lnaddr"] }</div>
                        }
                        <label for="players">players</label>
                        <input
                            id="players"
                            name="players"
                            type="number"
                            min="2"
                            max="2"
                            value="2"
                            disabled
                            class="my-1 p-2 rounded" />
                        <div class="text-muted text-sm text-end col-start-2">more than 2 players coming soon</div>
                    </div>
                    <div class="flex justify-end">
                        <a
                            id="cancel"
                            class="mx-3"
                            hx-get="/"
                            hx-target="#content"
                            hx-select="#content"
                        >cancel</a>
                        <button type="submit">submit</button>
                    </div>
                </form>
            }
        }
    </html>
}


templ GameSendInvite(g *db.Game) {
    <html>
        @components.Head()
        @components.Body() {
			@components.Content() {
                <div id="banner">
                    @components.Figlet("slant", "zapback")
                </div>
                <div>
                    <p class="text-center font-bold mb-4">
                        Send this link to a friend:
                    </p>
                    <div class="flex justify-center">
                        <a
                            href={ templ.SafeURL(fmt.Sprintf("https://%s/game/%s", _context.GetOrigin(ctx), g.Code)) }
                            class="flex justify-center break-all">
                            { fmt.Sprintf("https://%s/game/%s", _context.GetOrigin(ctx), g.Code) }
                        </a>
                        @components.CopyButton(fmt.Sprintf("https://%s/game/%s", _context.GetOrigin(ctx), g.Code))
                    </div>
                    <p class="text-center text-muted text-sm mt-8">you won't see this page again after leaving</p>
                </div>
            }
        }
    </html>
}

templ GameInvite(g *db.Game, err types.FormError) {
    <html>
        @components.Head()
        @components.Body() {
			@components.Content() {
                <div id="banner">
                    @components.Figlet("slant", "zapback")
                </div>
                <div class="mb-4">
                    <p class="text-center font-bold mb-3">
                        You have been invited to join a zapback game!
                    </p>
                    <p class="mb-3">
                        Here's how it works:
                    </p>
                    <ol class="list-disc list-inside">
                        <li>Zap the pool to start the game</li>
                        <li>Your friend has 24 hours to take their turn by zapping the pool</li>
                        <li>If they do zap, it becomes your turn again</li>
                        <li>If they don't zap in time, you win the entire pool!</li>
                    </ol>
                </div>
                <form
                    hx-post={ fmt.Sprintf("/game/%s", g.Code) }
                    hx-target="#modal"
                    hx-select="#modal"
                    hx-push-url="false"
                    hx-disabled-elt="button[type='submit']"
                    hx-on::before-request="document.querySelectorAll('.text-error').forEach(el => el.remove())">
                    <div class="grid grid-cols-[auto_auto] gap-x-4 items-center mb-4">
                        <label for="lnaddr">lightning address</label>
                        <input
                            id="lnaddr"
                            name="lnaddr"
                            type="text"
                            class="my-1 p-2 rounded w-full"
                            placeholder="how you get paid if you win"
                            autocomplete="off"
                            hx-preserve />
                        if err.HasError("lnaddr") {
                            <div class="text-error text-sm text-end col-start-2">{ err["lnaddr"] }</div>
                        }
                    </div>
                    <div class="flex justify-center">
                        <button type="submit" class="neon success !p-3">START GAME</button>
                    </div>
                </form>
            }
        }
    </html>
}

templ Game(g *db.Game, t *db.Turn) {
    <html>
        @components.Head()
        @components.Body() {
			@components.Content() {
                <div id="banner">
                    @components.Figlet("slant", "zapback")
                </div>
                <div class="grid grid-cols-[auto_auto] gap-x-4 items-center mb-4">
                    <label for="turn">turn:</label>
                    <div id="turn">{ t.Player.LightningAddress }</div>
                    <label for="pool">pool:</label>
                    <div id="pool">{ fmt.Sprintf("%d sats", t.PoolAmount/1000) }</div>
                </div>
                @components.GameInvoice(t.Invoice)
            }
        }
    </html>
}

templ GameFinished(g *db.Game, t *db.Turn, winner *db.Player) {
    <html>
        @components.Head()
        @components.Body() {
			@components.Content() {
                <div id="banner">
                    @components.Figlet("slant", "zapback")
                </div>
                <div class="grid grid-cols-[auto_auto] gap-x-4 items-center mb-4">
                    <label for="turn">turn:</label>
                    <div id="turn">{ t.Player.LightningAddress }</div>
                    <label for="pool">pool:</label>
                    <div id="pool">{ fmt.Sprintf("%d sats", t.PoolAmount/1000) }</div>
                </div>
                @components.GameInvoice(t.Invoice)
                <div class="grid grid-cols-[auto_auto] gap-x-4 items-center my-4">
                    <label for="turn" class="font-bold">winner:</label>
                    <div id="turn" class="font-bold">{ winner.LightningAddress }</div>
                    <div class="text-center text-muted text-sm col-span-2 my-4">
                        payouts are done manually for now
                    </div>
                </div>
            }
        }
    </html>
}

templ LoadGame(err types.FormError) {
    <html>
        @components.Head()
        @components.Body() {
			@components.Content() {
                <div id="banner-new">
                    @components.Figlet("slant", "load game")
                </div>
                <form
                    hx-post="/game/load"
                    hx-target="#content"
                    hx-select="#content"
                    hx-disabled-elt="button[type='submit']"
                    hx-on::before-request="document.querySelectorAll('.text-error').forEach(el => el.remove())">
                    <div class="grid grid-cols-[auto_auto] gap-x-4 items-center my-3">
                        <label for="code">code</label>
                        <input id="code" name="code" type="text" class="my-1 p-2 rounded" autocomplete="off" />
                        if err.HasError("code") {
                            <div class="text-error text-sm text-end col-start-2">{ err["code"] }</div>
                        }
                    </div>
                    <div class="flex justify-end">
                        <a
                            id="cancel"
                            class="mx-3"
                            hx-get="/"
                            hx-target="#content"
                            hx-select="#content"
                        >cancel</a>
                        <button type="submit">load</button>
                    </div>
                </form>
            }
        }
    </html>
}
